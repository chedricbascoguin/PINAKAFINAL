RewriteRule ^sw\.js$ assets/pwa/sw.js [L,QSA]

<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

# Provide conventional icon URLs without routing missing icons to the landing page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^favicon\.ico$ assets/images/resihunity-icon-192-v2.png [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^apple-touch-icon(?:-precomposed)?\.png$ assets/images/resihunity-icon-192-v2.png [L]

# Serve existing files/folders directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send application routes to the application entry point
RewriteRule ^ index.php [L,QSA]
